{
  // Dedicated jobs pipeline worker. Runs on a schedule, shares the app's KV
  // namespace, and holds its own Adzuna + trigger-token secrets (set via
  // `wrangler secret put`, not stored here).
  "name": "employsi-jobs-cron",
  "main": "index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "OPEN_ROLES_HISTORY", "id": "6f8be3a8968d4e24a05ae82b235a6a97" }
  ],
  // Historical job archive (append-only). Shared with the app + mobile workers.
  "d1_databases": [
    { "binding": "JOBS_ARCHIVE", "database_name": "employsi-jobs-archive", "database_id": "1c5f3ffb-b9d7-4233-b28b-0f1f8d193fe1" }
  ],
  "triggers": {
    // ":00 every 6 hours" advances the Adzuna/Muse/Jooble shard rotation (the
    // 50-company roster refreshes about once a day). The government board scrapes
    // each run in their own invocation so their paged fetches get a clean
    // subrequest budget separate from the shard's API calls and each other:
    // ":05" NT (jobs.nt.gov.au), ":15" VIC (careers.vic.gov.au),
    // ":30" WA (search.jobs.wa.gov.au), ":45" QLD (smartjobs.qld.gov.au).
    // 03:40 / 03:50 / 04:00 / 04:10 UTC: the company-news refresh, a quarter of
    // the 355-company roster each, so every company is refreshed every night
    // without any one invocation approaching the subrequest budget. Ten minutes
    // apart so the upstream sees a trickle rather than four bursts. See news.ts.
    // 04:20 / 04:25 / 04:35 / 04:55 UTC: the employer career-portal pull, a
    // quarter of the portals per tick (PORTAL_GROUPS in careerSites.ts). Those
    // minutes collide with none of the gov minute-prefix branches above.
    "crons": ["0 */6 * * *", "5 */6 * * *", "15 */6 * * *", "30 */6 * * *", "45 */6 * * *", "50 */6 * * *", "40 3 * * *", "50 3 * * *", "0 4 * * *", "10 4 * * *", "20 4 * * *", "25 4 * * *", "35 4 * * *", "55 4 * * *", "5 5 * * *", "15 5 * * *", "25 5 * * *", "35 5 * * *", "45 5 * * *", "55 5 * * *", "5 6 * * *", "15 6 * * *", "25 6 * * *", "35 6 * * *", "45 6 * * *", "55 6 * * *", "5 7 * * *", "15 7 * * *", "25 7 * * *", "35 7 * * *", "45 7 * * *", "55 7 * * *", "5 8 * * *", "15 8 * * *"]
  }
}
